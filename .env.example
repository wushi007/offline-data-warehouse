# 复制为 .env 后填写实际值。.env 已被 .gitignore 忽略，是敏感配置的唯一存放处。
# config/env.py、scheduler/airflow_env.sh、run.sh、etl/run_locked.sh 会自动加载它。
# cp .env.example .env && chmod 600 .env

# ---- 存储与数据范围（改路径不需要改 Python）----
DW_FS_URI=hdfs://localhost:8020
DW_WAREHOUSE_URI=hdfs://localhost:8020/warehouse/ecommerce
DW_SOURCE_CSV=hdfs://localhost:8020/data/ecommerce/2019-Nov.csv
DW_DATA_START=2019-10-01
DW_DATA_END=2019-10-31

# ---- Spark（默认 standalone；切本地模式用 SPARK_MASTER=local[6]）----
SPARK_MASTER=spark://localhost:7077
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_INSTANCES=4

# ---- Airflow 元数据库 ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASS=
AIRFLOW_DB_HOST=127.0.0.1
AIRFLOW_DB_PORT=3307
AIRFLOW_DB_NAME=airflow

# ---- 数仓 MySQL ----
DW_MYSQL_HOST=127.0.0.1
DW_MYSQL_PORT=3306
DW_MYSQL_USER=warehouse
DW_MYSQL_PASSWORD=
DW_MYSQL_DATABASE=dw_ads
DW_MYSQL_CHARSET=utf8mb4

# ---- StarRocks ----
SR_HOST=127.0.0.1
SR_PORT=9030
SR_USER=root
SR_PASSWORD=

# ---- 邮件告警（为空则跳过该通道）----
DW_ALERT_SMTP_HOST=
DW_ALERT_SMTP_PORT=465
DW_ALERT_SMTP_USER=
DW_ALERT_SMTP_PASS=
DW_ALERT_SMTP_TO=

# ---- Webhook 告警（企业微信 / 钉钉）----
DW_ALERT_WEBHOOK=

# ---- 飞书机器人 ----
DW_ALERT_FEISHU_WEBHOOK=
DW_ALERT_FEISHU_SECRET=
DW_ALERT_FEISHU_STYLE=card
