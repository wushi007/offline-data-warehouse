# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，不会入库。
# cp .env.example .env

# ---------------- MySQL（ADS 结果落地，供报表/看板读取） ----------------
DW_MYSQL_HOST=127.0.0.1
DW_MYSQL_PORT=3306
DW_MYSQL_USER=warehouse
DW_MYSQL_PASSWORD=
DW_MYSQL_DATABASE=dw_ads
DW_MYSQL_CHARSET=utf8mb4

# ---------------- StarRocks（性能基准 / ADS 导出用，可选） ----------------
SR_HOST=127.0.0.1
SR_PORT=9030
SR_USER=root
SR_PASSWORD=

# ---------------- 任务告警（scheduler/alerts.py） ----------------
# 邮件通道：为空则跳过该通道，只留台账
DW_ALERT_SMTP_HOST=
DW_ALERT_SMTP_PORT=465
DW_ALERT_SMTP_USER=
DW_ALERT_SMTP_PASS=
DW_ALERT_SMTP_TO=

# ---------------- HTTP Webhook 告警（企业微信 / 钉钉 / 飞书机器人） ----------------
DW_ALERT_WEBHOOK=

# ---------------- Airflow DAG 的路径配置（scheduler/incremental_warehouse_dag.py） ----------------
# DAG 会**自动探测**这些路径，通常不需要设置。
# 探测顺序：环境变量 > 约定俗成的安装位置 > 默认值。
# 只有装在非常规位置时才需要显式导出（在启动 Airflow 的环境里 export）。
#
# DW_PROJECT_ROOT=/path/to/ecom-warehouse
# DW_VENV_PYTHON=/path/to/venv/bin/python
#
# JAVA_HOME 已由 DAG 探测 /usr/lib/jvm/java-17-openjdk-*
# SPARK_HOME 探测顺序：~/apps/spark-*  →  /opt/spark*     →  /usr/local/spark*
# HADOOP_HOME 探测顺序：~/apps/hadoop-[0-9]*  →  /opt/hadoop*  →  /usr/local/hadoop*
#
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# SPARK_HOME=/opt/spark
# HADOOP_HOME=/opt/hadoop
# HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
#
# 数仓数据起点（RFM / 留存这类区间任务需要）
# DW_DATA_START=2019-10-01
